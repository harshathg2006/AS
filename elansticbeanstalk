✅ ✅ FINAL NODE.js CODE (COPY THIS EXACTLY)
📄 app.js

const express = require('express');
const app = express();

// Elastic Beanstalk uses dynamic port
const PORT = process.env.PORT || 3000;

// Home route
app.get('/', (req, res) => {
res.send('Hello from AWS Elastic Beanstalk 🚀');
});

// Start server
app.listen(PORT, () => {
console.log(Server running on port ${PORT});
});

